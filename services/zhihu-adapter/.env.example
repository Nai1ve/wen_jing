# 运行模式：mock / live
ZHIHU_PROVIDER_MODE=mock
ZHIHU_REQUEST_TIMEOUT_SECONDS=20

# Data Platform：搜索、全网搜索、热榜、直答
ZHIHU_ACCESS_SECRET=
ZHIHU_DATA_PLATFORM_BASE_URL=https://developer.zhihu.com
ZHIHU_DEFAULT_MODEL=zhida-thinking-1p5

# Community：openapi.zhihu.com HMAC 签名接口
ZHIHU_APP_KEY=
ZHIHU_APP_SECRET=
ZHIHU_COMMUNITY_BASE_URL=https://openapi.zhihu.com
ZHIHU_WRITABLE_RING_IDS=2001009660925334090,2015023739549529606,2029619126742656657
ZHIHU_DEFAULT_RING_ID=2029619126742656657

# OAuth：这组 app_id/app_key 与 Community 凭证不同
ZHIHU_OAUTH_APP_ID=
ZHIHU_OAUTH_APP_KEY=
ZHIHU_OAUTH_BASE_URL=https://openapi.zhihu.com
ZHIHU_OAUTH_AUTHORIZE_PATH=/authorize
ZHIHU_OAUTH_TOKEN_PATH=/access_token
# 你配置知乎后台时，把这里改成公网 HTTPS 回调地址
ZHIHU_OAUTH_REDIRECT_URI=http://127.0.0.1:8787/zhihu/oauth/callback
ZHIHU_ACCESS_TOKEN=
ZHIHU_TOKEN_FILE=.local/zhihu/oauth_token.json

# 文档页面列出的 OAuth 用户数据路径；若账号文档有差异，可用环境变量覆盖
ZHIHU_OAUTH_USER_PATH=/user
ZHIHU_OAUTH_MOMENTS_PATH=/user/moments
ZHIHU_OAUTH_FOLLOWED_PATH=/user/followed
ZHIHU_OAUTH_FOLLOWERS_PATH=/user/followers
ZHIHU_OAUTH_CONTENT_PATH=/user/content
ZHIHU_OAUTH_COLLECTIONS_PATH=/user/collections
ZHIHU_OAUTH_COLLECTION_PATH=/user/collection/{collection_id}

# 回调服务监听地址
ZHIHU_OAUTH_HOST=127.0.0.1
ZHIHU_OAUTH_PORT=8787
